# Example terraform.tfvars (SANITIZED)
# Copy this to terraform.tfvars (ignored) and fill in the real values.

# Proxmox provider
proxmox_url = "https://proxmox.example.local:8006"
proxmox_user = "terraform@pve"
# Either use password (not recommended) or a PVE API token (recommended)
# proxmox_password = "REPLACE_WITH_PASSWORD"
# proxmox_api_token_id = "terraform@pve!terraform-token"
# proxmox_api_token_secret = "REPLACE_WITH_SECRET"

# VM defaults
node_count = 3
vm_template = "ubuntu-22.04-cloud-init"
vm_memory  = 4096
vm_cpus    = 2
vm_disk_gb = 40

# Storage & network
storage_pool = "local-lvm"
network_bridge = "vmbr0"

# Notes:
# - Do NOT commit real credentials. Use environment variables or a secrets manager.
# - terraform.tfstate may contain sensitive data. Keep it local and/or encrypted.
